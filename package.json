{
  "name": "ecommerce-microservices",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:user-service && npm run build:product-service && npm run build:order-service && npm run build:api-gateway",
    "build:user-service": "tsc -p user-service/tsconfig.json",
    "build:product-service": "tsc -p product-service/tsconfig.json",
    "build:order-service": "tsc -p order-service/tsconfig.json",
    "build:api-gateway": "tsc -p api-gateway/tsconfig.json",
    "start:user-service": "node dist/user-service/user-service/src/main.js",
    "start:product-service": "node dist/product-service/product-service/src/main.js",
    "start:order-service": "node dist/order-service/order-service/src/main.js",
    "start:api-gateway": "node dist/api-gateway/api-gateway/src/main.js",
    "start:user-service:dev": "ts-node -P user-service/tsconfig.json user-service/src/main.ts",
    "start:product-service:dev": "ts-node -P product-service/tsconfig.json product-service/src/main.ts",
    "start:order-service:dev": "ts-node -P order-service/tsconfig.json order-service/src/main.ts",
    "start:api-gateway:dev": "ts-node -P api-gateway/tsconfig.json api-gateway/src/main.ts",
    "format": "prettier --write \"{shared,user-service,product-service,order-service,api-gateway}/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "lint": "eslint \"{shared,user-service,product-service,order-service,api-gateway}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^1.41.3",
    "mongoose": "^9.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
